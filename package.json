{
  "name": "voidmail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx src/server/main.ts api",
    "dev:mx": "tsx src/server/main.ts mx",
    "dev:worker": "tsx src/server/main.ts worker",
    "dev:web": "vite --config src/web/vite.config.ts",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outfile=dist/server/main.js && rm -rf dist/server/migrations && cp -r src/server/migrations dist/server/migrations",
    "build:web": "vite build --config src/web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/web/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config tests/e2e/vitest.e2e.config.ts",
    "test:ui": "playwright test --config tests/e2e/playwright.config.ts",
    "migrate": "node dist/server/main.js migrate",
    "admin": "node dist/server/main.js admin",
    "env:init": "sh infra/scripts/gen-env.sh"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "argon2": "0.45.1",
    "fastify": "5.12.5",
    "hash-wasm": "4.12.0",
    "mailparser": "3.9.31",
    "nodemailer": "10.0.12",
    "openpgp": "6.3.2",
    "otplib": "13.5.0",
    "pg": "8.23.0",
    "smtp-server": "3.19.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/jsdom": "30.0.0",
    "@types/mailparser": "3.9.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "@vitejs/plugin-react": "6.1.1",
    "dompurify": "3.4.16",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
