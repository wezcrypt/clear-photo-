# VoidMail configuration. Copy to .env (or run `npm run env:init`) and replace every placeholder.
# Never commit .env. All secrets below are placeholders.

NODE_ENV=production
MAIL_DOMAIN=voidmail.test
MAIL_HOSTNAME=mx.voidmail.test
PUBLIC_ORIGIN=http://localhost:8080
TRUST_PROXY=false
REGISTRATION_OPEN=true
# Username that receives postmaster@ and abuse@ mail (create this account first).
POSTMASTER_USER=

# 32-byte hex secrets (64 hex chars). Each MUST be different. Generate with: openssl rand -hex 32
APP_SECRET=__REPLACE_WITH_64_HEX__
AUTH_PEPPER=__REPLACE_WITH_64_HEX__
QUEUE_KEY=__REPLACE_WITH_64_HEX__
TOTP_KEY=__REPLACE_WITH_64_HEX__

POSTGRES_USER=voidmail
POSTGRES_DB=voidmail
POSTGRES_PASSWORD=__REPLACE_ME__

# DKIM: path inside the container to the PEM private key (mounted read-only). Leave empty to disable signing.
DKIM_SELECTOR=vm1
DKIM_PRIVATE_KEY_FILE=

# Sending limits (conservative defaults; no bulk sending).
MAX_RECIPIENTS_PER_MESSAGE=50
EXTERNAL_RECIPIENTS_PER_DAY=200
INTERNAL_RECIPIENTS_PER_DAY=2000
SENDS_PER_MINUTE=10
DEFAULT_QUOTA_BYTES=1073741824

# Postfix outbound routing. Production: DEFAULT_TRANSPORT=smtp, TLSREQ_LEVEL=verify (or dane).
# Development (docker-compose.yml) overrides these to route everything to local Mailpit sinks.
DEFAULT_TRANSPORT=smtp
TLSREQ_LEVEL=verify

# Backups (ops/backup.sh): passphrase for symmetric encryption of backup archives.
BACKUP_PASSPHRASE=__REPLACE_ME__
